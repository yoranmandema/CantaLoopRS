program = { SOI ~ (statement ~ ";")* ~ EOI}
statement = { assign_statement }

assign_statement = { identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression}

expression = { string | number | identifier }

identifier = { (alpha | digit)+ }

number = {digit+ ~ ("." ~ digit*)?}

alpha = { 'a'..'z' | 'A'..'Z' }
digit = { '0'..'9' }

string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

WHITESPACE = _{ " " }