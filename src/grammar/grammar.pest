program = { SOI ~ block ~ EOI }

block = { (WHITESPACE* ~ statement_without_semicolon ~ WHITESPACE* | WHITESPACE* ~ statement_with_semicolon ~ ";" ~ WHITESPACE*)* }
braced_block = ${ "{" ~ WHITESPACE* ~ block ~ WHITESPACE* ~ "}" }
non_assign_statement = { return_statement | let_statement | break_statement | continue_statement | expression_statement | use_statement | mod_statement }
statement_with_semicolon = { !("fn" ~ WHITESPACE) ~ !(("pub" ~ WHITESPACE+) ~ "fn" ~ WHITESPACE) ~ !(("pub" ~ WHITESPACE+) ~ "fn") ~ (let_statement | const_statement | return_statement | break_statement | continue_statement | assign_statement | assign_increment_statement | assign_decrement_statement | expression_statement | use_statement | mod_statement) }
// Try to match assignment patterns first before expression
maybe_assign = { identifier ~ WHITESPACE* ~ "=" }
maybe_assign_increment = { identifier ~ WHITESPACE* ~ "+=" }
maybe_assign_decrement = { identifier ~ WHITESPACE* ~ "-=" }
statement_without_semicolon = { function_statement | if_statement | pattern_match_statement | loop_statement | while_statement | for_statement }
statement = { statement_with_semicolon | statement_without_semicolon }

// Keywords - used for negative lookahead to prevent keywords from being identifiers
keyword = _{ "fn" ~ !ASCII_ALPHANUMERIC | "if" ~ !ASCII_ALPHANUMERIC | "else" ~ !ASCII_ALPHANUMERIC | "elseif" ~ !ASCII_ALPHANUMERIC | "match" ~ !ASCII_ALPHANUMERIC | "return" ~ !ASCII_ALPHANUMERIC | "let" ~ !ASCII_ALPHANUMERIC | "true" ~ !ASCII_ALPHANUMERIC | "false" ~ !ASCII_ALPHANUMERIC | "loop" ~ !ASCII_ALPHANUMERIC | "while" ~ !ASCII_ALPHANUMERIC | "for" ~ !ASCII_ALPHANUMERIC | "in" ~ !ASCII_ALPHANUMERIC | "break" ~ !ASCII_ALPHANUMERIC | "continue" ~ !ASCII_ALPHANUMERIC | "use" ~ !ASCII_ALPHANUMERIC | "mod" ~ !ASCII_ALPHANUMERIC | "pub" ~ !ASCII_ALPHANUMERIC | "const" ~ !ASCII_ALPHANUMERIC }

expression_statement = { !("fn" ~ WHITESPACE) ~ !("return" ~ WHITESPACE) ~ !("let" ~ WHITESPACE) ~ !maybe_assign ~ !maybe_assign_increment ~ !maybe_assign_decrement ~ expression }
let_statement = ${ ("pub" ~ WHITESPACE+)? ~ "let" ~ WHITESPACE+ ~ identifier ~ (WHITESPACE* ~ ":" ~ WHITESPACE* ~ type_annotation)? ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression }
const_statement = ${ ("pub" ~ WHITESPACE+)? ~ "const" ~ WHITESPACE+ ~ identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression }
assign_statement = ${ identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression }
assign_increment_statement = { identifier ~ WHITESPACE* ~ "+=" ~ WHITESPACE* ~ expression }
assign_decrement_statement = { identifier ~ WHITESPACE* ~ "-=" ~ WHITESPACE* ~ expression }

return_statement = ${ 
    "return" ~ WHITESPACE+ ~ expression
}

loop_init_var = { identifier ~ WHITESPACE* ~ "=" ~ WHITESPACE* ~ expression }
loop_init = ${ loop_init_var ~ (WHITESPACE* ~ "," ~ WHITESPACE* ~ loop_init_var)* }
loop_statement = { "loop" ~ WHITESPACE* ~ (loop_init ~ WHITESPACE*)? ~ braced_block }
while_statement = ${ "while" ~ WHITESPACE+ ~ expression ~ WHITESPACE* ~ braced_block }
// For loop: for x in start .. end { body }
// Parse manually like pattern_match_statement due to ".." not being a valid expression operator
for_statement = ${ "for" ~ WHITESPACE+ ~ identifier ~ WHITESPACE* ~ "in" ~ !ASCII_ALPHANUMERIC ~ WHITESPACE* ~ for_range_content ~ WHITESPACE* ~ ".." ~ WHITESPACE* ~ for_range_content ~ WHITESPACE* ~ "{" ~ for_block_manual ~ "}" }
for_range_content = { (for_range_char | "(" ~ for_range_content ~ ")" | "\"" ~ (!"\"" ~ ANY)* ~ "\"")* }
for_range_char = { !"}" ~ !"{" ~ !".." ~ ANY }
for_block_manual = { (for_block_char | "{" ~ for_block_manual ~ "}")* }
for_block_char = { !"}" ~ !"{" ~ ANY }
break_statement = ${ "break" ~ (WHITESPACE+ ~ expression)? }
continue_statement = { "continue" }

// Import/Use statements
use_statement = ${ "use" ~ WHITESPACE+ ~ import_items ~ WHITESPACE+ ~ "from" ~ WHITESPACE+ ~ import_path }
import_path = { identifier ~ ("." ~ identifier)* }
import_items = { "*" | identifier ~ (WHITESPACE* ~ "," ~ WHITESPACE* ~ identifier)* }

// Module declaration
mod_statement = ${ "mod" ~ WHITESPACE+ ~ identifier }

function_statement = ${
    ("pub" ~ WHITESPACE+)? ~ "fn" ~ WHITESPACE+ ~ identifier ~ WHITESPACE* ~ "(" ~ WHITESPACE* ~ function_args? ~ WHITESPACE* ~ ")" ~ WHITESPACE* ~ (return_type_annotation ~ WHITESPACE*)? ~ braced_block
}

return_type_annotation = { "->" ~ WHITESPACE+ ~ type_annotation }

function_args = { argument ~ ("," ~ WHITESPACE* ~ argument)* }

argument = { identifier ~ WHITESPACE* ~ ":" ~ WHITESPACE* ~ type_annotation }

// Type annotations: atom_type (("->" | "~>") atom_type)*
// Supports chained types like: num -> num, num ~> num, num -> num -> num, etc.
type_annotation = { atom_type ~ (WHITESPACE* ~ ("->" | "~>") ~ WHITESPACE* ~ atom_type)* }

// Atom types: num, str, bool, array types [type], etc.
atom_type = { array_type | identifier }
array_type = ${ "[" ~ WHITESPACE* ~ atom_type ~ WHITESPACE* ~ "]" }

if_statement = ${
    "if" ~ WHITESPACE+ ~ expression ~ WHITESPACE* ~ braced_block
    ~ (WHITESPACE* ~ "elseif" ~ !ASCII_ALPHANUMERIC ~ WHITESPACE+ ~ expression ~ WHITESPACE* ~ braced_block)*
    ~ (WHITESPACE* ~ "else" ~ !ASCII_ALPHA ~ WHITESPACE* ~ braced_block)?
}
pattern_if_statement = { "if" ~ WHITESPACE+ ~ identifier ~ WHITESPACE+ ~ "{" ~ WHITESPACE* ~ pattern_case+ ~ WHITESPACE* ~ "}" }
// pattern_match_statement is parsed manually from text due to silent expression rules
// We just match the basic structure: "match" expression "{" ... "}"
pattern_match_statement = ${ "match" ~ WHITESPACE+ ~ expression ~ WHITESPACE* ~ "{" ~ match_cases_content ~ "}" }
// Match the content between braces manually (handles nested braces)
match_cases_content = { (match_cases_char | "{" ~ match_cases_content ~ "}")* }
match_cases_char = { !"}" ~ !"{" ~ ANY }
pattern_case = ${ pattern_value ~ WHITESPACE+ ~ braced_block }
pattern_value = { comparison_pattern | expression | wildcard }
comparison_pattern = ${ comparison_operator ~ WHITESPACE+ ~ expression }
wildcard = { "_" }
comparison_operator = { gt | lt | ge | le | eq | ne }

// --- Loop Expression ---
// Fully atomic in expressions to prevent PEG from continuing infix parsing
// The entire loop expression is matched atomically - AST builder parses init and body manually
loop_expression = ${ "loop" ~ WHITESPACE* ~ (loop_init ~ WHITESPACE*)? ~ "{" ~ loop_block_manual ~ "}" }
// Match optional init vars using the same grammar as loop_statement
// Match block content with proper brace counting (handles nested braces)
loop_block_manual = { (loop_block_char | "{" ~ loop_block_manual ~ "}")* }
loop_block_char = { !"}" ~ !"{" ~ ANY }

// Wrap loop_expression as atomic so PEG treats it as indivisible
atomic_loop_expression = _{ loop_expression }

// --- Primary Expressions ---
member_access = { identifier ~ ("." ~ identifier)+ }
primary   = { value | call_expression | atomic_loop_expression | member_access | identifier | "(" ~ expression ~ ")" | array_literal }

// --- Atom & Expression ---
atom = { primary ~ (WHITESPACE* ~ postfix)* }
postfix   = { invoke | call | array_index }
invoke    = { "!" ~ !"=" ~ invoke_args? }
invoke_args = { "(" ~ WHITESPACE* ~ expression_list? ~ WHITESPACE* ~ ")" }
call      = { "(" ~ WHITESPACE* ~ expression_list? ~ WHITESPACE* ~ ")" }

// Array indexing
// We parse index specs manually in the AST builder due to complex syntax
array_index = ${ "[" ~ WHITESPACE* ~ index_content ~ WHITESPACE* ~ "]" }
index_content = { (index_char | "[" ~ index_content ~ "]")* }
index_char = { !"]" ~ ANY }

prefix    = _{ increment | decrement | neg | not }
increment = { "++" }
decrement = { "--" }
neg       = { "-" }
not       = { "!" }

expression = _{
    prefix? ~ WHITESPACE* ~ atom ~ (WHITESPACE* ~ infix ~ WHITESPACE* ~ prefix? ~ WHITESPACE* ~ atom)*
}

infix     = _{ add | sub | mul | div | modulo | pow | eq | ne | ge | le | pipe_forward | pipe_reverse | gt | lt | and | or }
add       = { "+" }
sub       = { "-" }
mul       = { "*" }
div       = { "/" }
modulo    = { "%" }
pow       = { "^" }
eq        = { "==" }
ne        = { "!=" }
gt        = { ">" }
lt        = { "<" }
ge        = { ">=" }
le        = { "<=" }
and       = { "&&" }
or        = { "||" }
pipe_forward = { "|>" }
pipe_reverse = { "<|" }

call_expression = ${ identifier ~ WHITESPACE* ~ "(" ~ WHITESPACE* ~ expression_list? ~ WHITESPACE* ~ ")" }
expression_list = { (expression | placeholder) ~ (WHITESPACE* ~ "," ~ WHITESPACE* ~ (expression | placeholder))* }
placeholder = { "_" }

value = { number | string | boolean | array_literal }
array_literal = ${ "[" ~ WHITESPACE* ~ expression_list? ~ WHITESPACE* ~ "]" }

identifier = @{ !("fn" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("if" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("else" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("elseif" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("match" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("return" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("let" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("true" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("false" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("loop" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("while" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("for" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("in" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("break" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("continue" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("use" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("mod" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("pub" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ !("const" ~ (WHITESPACE | !(ASCII_ALPHANUMERIC | "_"))) ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

number = { digit+ ~ ("." ~ digit*)? }
string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
boolean = { true | false }

true = { "true" }
false = { "false" }
alpha = { 'a'..'z' | 'A'..'Z' }
digit = { '0'..'9' }

operator = { "+" | "-" | "*" | "/" | "%" | "=" | "!=" | ">" | "<" | ">=" | "<=" }

// Comments
line_comment = _{ "//" ~ (!"\n" ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
WHITESPACE = _{ " " | "\t" | "\r" | "\n" | line_comment | block_comment }
