{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "CantaLoop",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#imports"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#type_annotations"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#member_access"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.cantaloop",
                    "match": "\\b(struct|fn|if|else|elseif|match|return|let|and|or|use|loop|while|for|break|continue|in|mod|pub|const|use|from)\\b"
                },
                {
                    "name": "constant.language.boolean.cantaloop",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.cantaloop",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.cantaloop",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.cantaloop",
            "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.cantaloop",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.cantaloop",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "meta.function-call.cantaloop",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.cantaloop"
                        }
                    }
                }
            ]
        },
        "imports": {
            "patterns": [
                {
                    "name": "meta.import.cantaloop",
                    "begin": "\\buse\\b",
                    "end": "\\bfrom\\b",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.import.cantaloop"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "keyword.control.import.cantaloop"
                        }
                    },
                    "patterns": [
                        {
                            "name": "variable.other.readwrite.cantaloop",
                            "match": "\\*|\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                        }
                    ]
                },
                {
                    "name": "meta.import.cantaloop",
                    "begin": "\\bfrom\\b",
                    "end": "(?=;|$|\\n)",
                    "beginCaptures": {
                        "0": {
                            "name": "keyword.control.import.cantaloop"
                        }
                    },
                    "patterns": [
                        {
                            "name": "entity.name.namespace.cantaloop",
                            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*\\b"
                        }
                    ]
                }
            ]
        },
        "type_annotations": {
            "patterns": [
                {
                    "name": "meta.type.annotation.cantaloop",
                    "begin": "(:)",
                    "end": "(?=\\s*[,;=)\\]\\}\\n])",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.separator.type.cantaloop"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#type_name"
                        },
                        {
                            "include": "#type_operators"
                        }
                    ]
                },
                {
                    "name": "meta.return.type.cantaloop",
                    "begin": "(->|~>)",
                    "end": "(?=\\s*[{;]|$)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.type.cantaloop"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#type_name"
                        },
                        {
                            "include": "#type_operators"
                        }
                    ]
                }
            ]
        },
        "type_name": {
            "patterns": [
                {
                    "name": "support.type.primitive.cantaloop",
                    "match": "\\b(num|str|bool|void|any)\\b"
                },
                {
                    "name": "support.type.array.cantaloop",
                    "begin": "\\[",
                    "end": "\\]",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.array.begin.cantaloop"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.array.end.cantaloop"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#type_name"
                        },
                        {
                            "include": "#type_operators"
                        }
                    ]
                },
                {
                    "name": "entity.name.type.cantaloop",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "type_operators": {
            "patterns": [
                {
                    "name": "keyword.operator.type.value.cantaloop",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.type.effect.cantaloop",
                    "match": "~>"
                }
            ]
        },
        "member_access": {
            "patterns": [
                {
                    "name": "meta.member-access.cantaloop",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.namespace.cantaloop"
                        },
                        "2": {
                            "name": "punctuation.separator.accessor.cantaloop"
                        },
                        "3": {
                            "name": "entity.name.function.cantaloop"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "constant.language.placeholder.cantaloop",
                    "match": "\\?"
                },
                {
                    "name": "keyword.operator.type.value.cantaloop",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.type.effect.cantaloop",
                    "match": "~>"
                },
                {
                    "name": "keyword.operator.pipe.cantaloop",
                    "match": "(\\|>|<\\|)"
                },
                {
                    "name": "keyword.operator.logical",
                    "match": "(\\|\\||&&)"
                },
                {
                    "name": "keyword.operator.range.cantaloop",
                    "match": "(\\.\\.)"
                },
                {
                    "name": "keyword.operator.arithmetic.cantaloop",
                    "match": "(\\+\\+|--|==|!=|>=|<=|\\+=|-=|\\+|-|\\*|/|\\^|>|<|=|%)"
                },
                {
                    "name": "keyword.operator.postfix.cantaloop",
                    "match": "(!)(?=\\s|$|[;,)])"
                }
            ]
        },
        "identifiers": {
            "name": "variable.other.readwrite.cantaloop",
            "match": "\\b(?!struct\\b|fn\\b|if\\b|else\\b|elseif\\b|match\\b|return\\b|let\\b|and\\b|or\\b|use\\b|loop\\b|while\\b|for\\b|break\\b|continue\\b|in\\b|mod\\b|pub\\b|const\\b|from\\b|true\\b|false\\b)[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
    },
    "scopeName": "source.cantaloop"
}