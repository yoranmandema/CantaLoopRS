{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "CantaLoop",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.cantaloop",
                    "match": "\\b(fn|if|else|elseif|match|return|let|and|or)\\b"
                },
                {
                    "name": "constant.language.boolean.cantaloop",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.cantaloop",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.cantaloop",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.cantaloop",
            "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.cantaloop",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.cantaloop",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.cantaloop",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.cantaloop",
                    "match": "(\\+\\+|--|==|!=|>=|<=|\\+|-|\\*|/|\\^|>|<|=|\\+=|-=)"
                },
                {
                    "name": "keyword.operator.postfix.cantaloop",
                    "match": "(!)(?=\\s|$|[;,)])"
                }
            ]
        }
    },
    "scopeName": "source.cantaloop"
}
