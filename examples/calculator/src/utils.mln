mod utils;

pub fn is_ws (s: str) -> bool {
    return s == " " || s == "\t" || s == "\n" || s == "\r";
}

pub fn is_digit (s: str) -> bool {
    if s == "0" {
            return true;
        }
        if s == "1" {
            return true;
        }
        if s == "2" {
            return true;
        }
        if s == "3" {
            return true;
        }
       if s  == "4" {
            return true;
        }
        if s == "5" {
            return true;
        }
        if s == "6" {
            return true;
        }
       if s  == "7" {
            return true;
        }
        if s == "8" {
            return true;
        }
       if s  == "9" {
            return true;
        }
    

    return false;
}