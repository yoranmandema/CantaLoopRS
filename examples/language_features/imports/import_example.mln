use print from std;

// Example demonstrating imports in CantaLoop

// Single import: use max from math;
use max from math;

// Multiple imports: use cube, pow from math;
use cube, pow from math;

// Wildcard import: use * from math;
use * from math;

// Use the imported functions
let result1 = square(5)!;
let result2 = cube(3)!;
let result3 = pow(2, 8)!;

print(result1)!;
print(result2)!;
print(result3)!;

