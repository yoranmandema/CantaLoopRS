use std.print;

// Define a function normally
fn greet(name: string) -> string {
    return "Hello, " + name;
}

// Prepare a thunk, nothing executes yet
let say_hello = greet("Alice");

print("Prepared the thunk, nothing happened yet")!;

// Actually call the thunk
let result: string = say_hello!;
print(result)!;  // prints: Hello, Alice

// You can reuse the thunk if you want
let another_call: string = say_hello!;
print(another_call)!;  // prints: Hello, Alice

// You can extend this to currying naturally:
fn add(a: num, b: num) -> num {
    return a + b;
}

// Create a partially applied thunk
let add5 = add(5, _);

// Only provide the second argument later
let number_result: num = add5(10)!;  // returns 15

print(number_result)!;

print(add5(10)!)!; // prints: 15
