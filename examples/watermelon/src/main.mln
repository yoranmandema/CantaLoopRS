use print from std;

print("Hello, world! 🍉")!;
 
fn add (a: num, b: num) -> num {
    return a + b;
}

fn mul (a: num, b: num) -> num {
    return a * b;
}

print(add(1,2))!;

let a = add(1, 4);

print(a)!;

let add5 = add(?, 5);
let add5mul2 = add(?, 5) |> mul(?, 2);

print(add5(10))!;
print(add5mul2(10))!;
print(add5mul2(2))!;
print(add5mul2(4))!;