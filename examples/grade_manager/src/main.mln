use print, format_number from std;
use sum from math;
use calculate_average, calculate_final_grade, grade_statistics, highest_grade, lowest_grade, calculate_weighted_average from grades;
use letter_grade from students;
use student_performance, generate_student_report from students;

// Student Grade Management System
// Demonstrates real-world data processing with arrays, functions, and aggregation

print("========================================")!;
print("  Student Grade Management System      ")!;
print("========================================\n")!;

// Sample student data
// Student 1: Alice
let alice_assignments = [85, 92, 88, 90, 87];
let alice_exams = [91, 89, 93];
let alice_final = student_performance(alice_assignments, alice_exams);

// Student 2: Bob  
let bob_assignments = [78, 82, 75, 80, 79];
let bob_exams = [76, 81, 78];
let bob_final = student_performance(bob_assignments, bob_exams);

// Student 3: Charlie
let charlie_assignments = [95, 98, 92, 96, 94];
let charlie_exams = [97, 96, 98];
let charlie_final = student_performance(charlie_assignments, charlie_exams);

// Generate and print reports
print(generate_student_report("Alice", alice_assignments, alice_exams))!;
print("\n")!;

print(generate_student_report("Bob", bob_assignments, bob_exams))!;
print("\n")!;

print(generate_student_report("Charlie", charlie_assignments, charlie_exams))!;
print("\n")!;

// Class statistics
print("=== Class Statistics ===")!;

let all_students = [alice_final, bob_final, charlie_final];
let class_average = calculate_average(all_students);

print("Class Average: " + format_number(class_average, 2) + "%")!;
print("Letter Grade: " + letter_grade(class_average))!;

// Find top and bottom performers
let top_performer = highest_grade(all_students);
let bottom_performer = lowest_grade(all_students);

print("\nTop Final Grade: " + top_performer + "%")!;
print("Bottom Final Grade: " + bottom_performer + "%")!;

// Example: Weighted grade calculation
print("\n=== Weighted Grade Example ===")!;
let test_scores = [88, 92, 85, 90];
let test_weights = [0.2, 0.3, 0.2, 0.3]; // Different weights for each test
let weighted_avg = calculate_weighted_average(test_scores, test_weights);
print("Test Scores: " + test_scores)!;
print("Weights: " + test_weights)!;
print("Weighted Average: " + format_number(weighted_avg, 2) + "%")!;
print("Letter Grade: " + letter_grade(weighted_avg))!;

print("\n========================================")!;
print("  End of Grade Report                  ")!;
print("========================================")!;
