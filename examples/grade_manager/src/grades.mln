mod grades;

use array_length from std;
use sum from math;

// Calculate the average of a list of grades
fn calculate_average(grades: [num]) -> num {
    let len = array_length(grades)!;
    if len == 0 {
        return 0;
    }
    let total = grades |> sum;
    return total / len;
}

// Calculate weighted average of grades with corresponding weights
// weights must have the same length as grades
// Note: This uses a loop because we need to iterate over two arrays simultaneously
fn calculate_weighted_average(grades: [num], weights: [num]) -> num {
    let total_weight = 0;
    let weighted_sum = 0;
    let len = array_length(grades)!;
    let i = 0;
    
    loop i = 0 {
        if i >= len {
            break;
        }
        weighted_sum = weighted_sum + (grades[i] * weights[i]);
        total_weight = total_weight + weights[i];
        i = i + 1;
    }
    
    if total_weight == 0 {
        return 0;
    }
    return weighted_sum / total_weight;
}

// Calculate final grade using weighted categories
// assignments_weight: weight for assignments (0-1)
// exams_weight: weight for exams (0-1)
fn calculate_final_grade(assignments: [num], exams: [num], assignments_weight: num, exams_weight: num) -> num {
    let assignments_avg = calculate_average(assignments);
    let exams_avg = calculate_average(exams);
    return (assignments_avg * assignments_weight) + (exams_avg * exams_weight);
}

// Find the highest grade in a list using fold
fn highest_grade(grades: [num]) -> num {
    if array_length(grades)! == 0 {
        return 0;
    }
    // Using loop instead of fold due to parser issue
    let max_val = 0;
    let len = array_length(grades)!;
    let i = 0;
    
    loop i = 0 {
        if i >= len {
            break;
        }
        if i == 0 || grades[i] > max_val {
            max_val = grades[i];
        }
        i = i + 1;
    }
    
    return max_val;
}

// Find the lowest grade in a list using fold
fn lowest_grade(grades: [num]) -> num {
    if array_length(grades)! == 0 {
        return 100;
    }
    // Using loop instead of fold due to parser issue
    let min_val = 100;
    let len = array_length(grades)!;
    let i = 0;
    
    loop i = 0 {
        if i >= len {
            break;
        }
        if i == 0 || grades[i] < min_val {
            min_val = grades[i];
        }
        i = i + 1;
    }
    
    return min_val;
}

// Calculate grade statistics (average, highest, lowest)
// Returns array [average, highest, lowest] since tuples aren't supported
fn grade_statistics(grades: [num]) -> [num] {
    let avg = calculate_average(grades);
    let highest = highest_grade(grades);
    let lowest = lowest_grade(grades);
    return [avg, highest, lowest];
}
