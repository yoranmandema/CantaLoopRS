// Advanced pattern matching examples

// Matching on computed values
fn classify_number(n: num) -> string {
    match n {
        == 0 {
            return "zero";
        }
        < 0 {
            return "negative";
        }
        > 100 {
            return "large";
        }
        > 10 {
            return "medium";
        }
        _ {
            return "small";
        }
    }
}

print("Classify 0: " + classify_number(0)!)!; // prints "Classify 0: zero"
print("Classify -5: " + classify_number(-5)!)!; // prints "Classify -5: negative"
print("Classify 50: " + classify_number(50)!)!; // prints "Classify 50: medium"
print("Classify 200: " + classify_number(200)!)!; // prints "Classify 200: large"
print("Classify 7: " + classify_number(7)!)!; // prints "Classify 7: small"

// Matching with multiple conditions
fn evaluate_score(score: num) -> string {
    match score {
        >= 90 {
            return "Excellent";
        }
        >= 80 {
            return "Good";
        }
        >= 70 {
            return "Average";
        }
        >= 60 {
            return "Pass";
        }
        _ {
            return "Fail";
        }
    }
}

print("Score 95: " + evaluate_score(95)!)!; // prints "Score 95: Excellent"
print("Score 75: " + evaluate_score(75)!)!; // prints "Score 75: Good"
print("Score 45: " + evaluate_score(45)!)!; // prints "Score 45: Average"

// Using match in functions
fn sign(n: num) -> num {
    match n {
        > 0 {
            return 1;
        }
        < 0 {
            return -1;
        }
        _ {
            return 0;
        }
    }
}

print("Sign of 10: " + sign(10)!)!; // prints "Sign of 10: 1"
print("Sign of -5: " + sign(-5)!)!; // prints "Sign of -5: -1"
print("Sign of 0: " + sign(0)!)!; // prints "Sign of 0: 0"

// Combining with other expressions
let x = 42;

match x {
    == 0 {
        print("x is zero")!;
    }
        == 42 {
        print("x is forty-two")!;
    }
    > 0 and < 10 {
        print("x is a single digit positive number")!;
    }
    >= 10 and < 100 {
        print("x is a two-digit number")!;
    }
    >= 100 {
        print("x is a large number")!;
    }
    _ {
        print("x is negative")!;
    }
}

