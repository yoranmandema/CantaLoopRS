// Unary operators: negation (-), not (!), increment (++), decrement (--)

// Negation
let positive = 5;
let negative = -positive;
print(negative)!; // Negative of 5

let result = -10 + 5;
print(result)!; // Should be -5

// Logical not
let is_true = true;
let is_false = !is_true;
print(is_false)!; // Not true

let value = 10;
if !(value == 0) {
    print("Value is not zero")!;
}

// Increment and decrement (prefix only)
let counter = 0;

++counter;
print(counter)!; // After ++, should be 1

--counter;
print(counter)!; // After --, should be 0

// Using in expressions
let a = 5;
++a;
let b = a;
print(a)!; // After ++a, should be 6
print(b)!; // b should also be 6

let c = 10;
--c;
let d = c;
print(c)!; // After --c, should be 9
print(d)!; // d should also be 9

// Combining unary operators
let x = 10;
let y = -x; // y is -10
let z = -y; // z is 10 (double negation)
print(x)!;
print(y)!;
print(z)!;

