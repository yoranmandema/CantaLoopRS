// Binary search implementation (simplified for demonstration)
// Since we don't have arrays, we'll search for a value in a range

fn binary_search_recursive(target: num, low: num, high: num) -> num {
    if low > high {
        return -1; // Not found
    }

    let mid = low + (high - low) / 2;

    if mid == target {
        return mid;
    } else {
        if mid < target {
            return binary_search_recursive(target, mid + 1, high)!;
        } else {
            return binary_search_recursive(target, low, mid - 1)!;
        }
    }
}

// Check if a number is a perfect square using binary search
fn is_perfect_square(n: num) -> bool {
    if n < 0 {
        return false;
    }
    if n == 0 or n == 1 {
        return true;
    }

    let low = 1;
    let high = n;

    while low <= high {
        let mid = low + (high - low) / 2;
        let square = mid * mid;

        if square == n {
            return true;
        } else {
            if square < n {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }
    }

    return false;
}

print(is_perfect_square(16)!)!; // Should be true
print(is_perfect_square(17)!)!; // Should be false
print(is_perfect_square(25)!)!; // Should be true

