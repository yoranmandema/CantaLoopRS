use print from std;
use map from functional;

// Effectfulness
// This code serves to give syntax and semantic explanation about effect and value functions

// Effect: () ~> any; as denoted by ~>
// Pure: () -> any: as denoted by ->

// only returns a value, has no side effect -> directly invokable using ()
fn add(a: num, b: num) -> num {
    return a + b;
}

// Has side-effect; namely printing to a terminal using print which in itself has an effect
// -> has to be invoked explicitly using postfix ! and has to be typed with ~> 
fn printHello (name: str) ~> void {
    print("Hello " + name + "!")!; // Print in itself has a side effect, thus the callee - printHello - has a side effect.
}

// Has side-effect but also returns value; namely printing to a terminal using print which in itself has an effect
// -> has to be invoked explicitly using postfix ! and has to be typed with ~> 
fn printAdd (a: num, b: num) ~> num {
    print("Adding " + a + " + " + b)!; // Print in itself has a side effect, thus the callee - printHello - has a side effect.

    return a + b;
}


let resultOf5add4 = add(5,4); // 5 + 4 = 10 Eagerly invoked since all arguments are met and function is value function and has no effects
print(resultOf5add4)!;

let add5 = add(?,5); // Produces thunk (x: num) -> num as b has already been consumed by '5'

print(add5(10))!;

// Value composition examples; 
let xs = [1,2,3,4]; 

let mapped = xs |> map(fn (x: num) -> num => add(x, 2)); // Should be valid since arguments of add and map are met. No ! needed as there's no side effects

print(mapped)!;

let mappedComposit = xs |> map(add(?, 2)); // Clean way of doing the same; passing a thunk to map

print(mappedComposit)!;

let app = bevy.app() // Produces a value
    |> bevy.with_default_plugins() // Value gets piped into with_default_plugins, which returns a new value
    |> bevy.with_window("My Game", 1280, 720) // Returns a new value with the previous value's properties and also with a window
    |> bevy.with_clear_color(0.1, 0.1, 0.1); // Returns a new value with the previous value's properties and also with a determined clear color

bevy.run(app)!; // since run has an effect it has to be called explicitly


// Function composition:
fn mul (a: num, b: num) -> num {
    return a * b;
}

let add5andMul2 = add(?,5) |> mul(?,2); // Produces a thunk (x: num) ~> num that adds 5 to the input, and then multiplies that by 2.

let res = add5andMul2(10); // Should be eagerly invoked as there's no side effects. Results in (10 + 5) * 2 = 30

print(res)!;

// let invalidPipeline = add(1,3) |> mul(?, 2); // Invalid -> no arguments to pass through?

fn fetch (url: str) ~> str {
    print("Pretending to fetch " + url)!;

    return "{ \"status\": \"OK\"}";
}

// Effectful pipeline
let effectfulPipeline = fetch(?) |> print(?);   

effectfulPipeline("https://www.google.com/")!;

// Pipeline with no args
