    default_config()
    |> with_logging()
    |> with_cache();*/


/*

============================

Here:

bevy.app → callable

bevy.with_default_plugins → callable

bevy.run → effectful callable

Pipeline → effectful callable

Execution → only at !

This is exactly what pipelines are for.
*/



let runApp =
    bevy.app
    |> bevy.with_default_plugins
    |> bevy.with_window("My Game", 1280, 720)
    |> bevy.with_clear_color(0.1, 0.1, 0.1)
    |> bevy.run;

runApp!;   // executes the effect
