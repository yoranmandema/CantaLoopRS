{
    // Alternative LSP configuration formats
    
    // For "LSP" extension by glenn2223, use this format:
    "lsp.servers": {
        "cantaloop": {
            "command": "${workspaceFolder}/target/release/cantaloop-lsp.exe",
            "filetypes": ["cantaloop"],
            "rootPatterns": [".git", "Cargo.toml"]
        }
    },
    
    // For "vscode-langservers-extracted" or other extensions, you might need:
    "languageServerExample.cantaloop.path": "${workspaceFolder}/target/release/cantaloop-lsp.exe",
    
    // File associations (always needed)
    "files.associations": {
        "*.mln": "cantaloop"
    },
    
    // Editor settings
    "[cantaloop]": {
        "editor.defaultFormatter": null,
        "editor.formatOnSave": false,
        "editor.wordBasedSuggestions": "off"
    }
}

