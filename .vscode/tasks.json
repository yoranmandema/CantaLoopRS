{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Rebuild Extension",
            "type": "shell",
            "windows": {
                "command": "bash scripts/rebuild-extension.sh",
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "${workspaceFolder}/scripts/rebuild-extension.sh"
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/rebuild-extension.sh"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Reinstall Extension",
            "type": "shell",
            "windows": {
                "command": "C:\\Program Files\\Git\\bin\\bash.exe",
                "args": [
                    "-c",
                    "cd .cantaloop-language && code --uninstall-extension yoran.cantaloop-language && code --install-extension cantaloop-language-0.0.1.vsix"
                ]
            },
            "osx": {
                "command": "cd .cantaloop-language && code --uninstall-extension yoran.cantaloop-language && code --install-extension cantaloop-language-0.0.1.vsix"
            },
            "linux": {
                "command": "cd .cantaloop-language && code --uninstall-extension yoran.cantaloop-language && code --install-extension cantaloop-language-0.0.1.vsix"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Quick Rebuild LSP (Dev)",
            "type": "shell",
            "windows": {
                "command": "bash scripts/rebuild-lsp-dev.sh",
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "${workspaceFolder}/scripts/rebuild-lsp-dev.sh"
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/rebuild-lsp-dev.sh"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Watch: All (Auto-rebuild)",
            "type": "shell",
            "windows": {
                "command": "bash scripts/watch-all.sh",
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "${workspaceFolder}/scripts/watch-all.sh"
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/watch-all.sh"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Watch: LSP (Auto-rebuild)",
            "type": "shell",
            "windows": {
                "command": "bash scripts/watch-lsp.sh",
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "${workspaceFolder}/scripts/watch-lsp.sh"
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/watch-lsp.sh"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Watch: melon (Auto-rebuild)",
            "type": "shell",
            "windows": {
                "command": "bash scripts/watch-melon.sh",
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "osx": {
                "command": "${workspaceFolder}/scripts/watch-melon.sh"
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/watch-melon.sh"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": [],
            "isBackground": true
        }
    ]
}
